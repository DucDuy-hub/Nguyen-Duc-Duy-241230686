@model Ndd_241230686_Lab3.Models.Book

@{
    ViewData["Title"] = "Edit";
}

<h2>Chỉnh sửa sách</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id">

    <div class="form-group">
        <label asp-for="Title">Tên sách</label>
        <input asp-for="Title" class="form-control">
    </div>

    <div class="form-group">
        <label>Tác giả</label>
        <select asp-for="AuthorId" class="form-control" asp-items="ViewBag.authors"></select>
    </div>

    <div class="form-group">
        <label>Thể loại</label>
        <select asp-for="GenreId" class="form-control" asp-items="ViewBag.genres"></select>
    </div>

    <div class="form-group">
        <label asp-for="Price">Giá sách</label>
        <input asp-for="Price" class="form-control">
    </div>

    <div class="form-group">
        <label asp-for="TotalPage">Tổng số trang</label>
        <input asp-for="TotalPage" class="form-control">
    </div>

    <div class="form-group">
        <label asp-for="Image">Hình ảnh / Poster</label>
        <input asp-for="Image" class="form-control">
    </div>

    <div class="form-group">
        <label asp-for="Summary">Giới thiệu ngắn</label>
        <textarea asp-for="Summary" class="form-control" rows="4"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Lưu lại</button>
    <a asp-action="Index" class="btn btn-default">Quay lại</a>
</form>
