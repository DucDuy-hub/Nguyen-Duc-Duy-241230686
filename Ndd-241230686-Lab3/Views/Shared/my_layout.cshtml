<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>NET CORE 2.x - @ViewBag.Title</title>
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { padding-bottom: 30px; }
        .banner { margin-bottom: 25px; }
        .product-img { width:100%; height:180px; object-fit:cover; }
        .book-img { width:55px; height:70px; object-fit:cover; }
        footer { margin-top:40px; padding:25px; background:#222; color:#fff; text-align:center; }
    </style>
</head>
<body>
    <nav class="navbar navbar-inverse">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">NET CORE 2.x</a>
            <ul class="nav navbar-nav">
                <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li><a asp-controller="Home" asp-action="About">Giới thiệu</a></li>
                <li><a asp-controller="Home" asp-action="Contact">Liên hệ</a></li>
                <li><a asp-controller="Book" asp-action="Index">Sách</a></li>
            </ul>
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>

    <footer>
        <p>ASP.NET Core MVC - Bài thực hành</p>
    </footer>

    <script src="https://code.jquery.com/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
