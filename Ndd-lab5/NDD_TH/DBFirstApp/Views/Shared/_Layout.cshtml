<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - DBFirstApp</title>
    <style>
        body{margin:0;background:#f4f6fa;color:#202a40;font:15px "Segoe UI",sans-serif}
        header{padding:18px 5vw;background:#171c2b;color:#fff;font-weight:700}
        main{max-width:1100px;margin:36px auto;padding:0 20px}
        .card{padding:24px;background:#fff;border:1px solid #e4e8ef;border-radius:12px}
        .top{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
        .btn{display:inline-block;padding:9px 13px;border:0;border-radius:7px;background:#6257e8;color:#fff;text-decoration:none;cursor:pointer}
        .btn-light{background:#eef0f5;color:#38445a}.btn-danger{background:#c43e52}
        table{width:100%;border-collapse:collapse}th,td{padding:12px;border-bottom:1px solid #edf0f4;text-align:left}th{color:#70798c;font-size:12px;text-transform:uppercase}
        label{display:block;margin:14px 0 6px;font-weight:600}input,select{box-sizing:border-box;width:100%;padding:10px;border:1px solid #d8dde7;border-radius:7px}
        .actions{display:flex;gap:8px;margin-top:20px}.error{color:#b42335}.notice{padding:12px;background:#fff2e1;border-radius:7px}
    </style>
</head>
<body>
    <header>School Management · Database First</header>
    <main>@RenderBody()</main>
</body>
</html>
