@model Learner
@{
    ViewData["Title"] = "Delete learner";
    var canDelete = (bool)ViewBag.CanDelete;
}

<div class="top"><h1>Delete learner</h1><a class="btn btn-light" asp-action="Index">Back to list</a></div>
<section class="card">
    @if (canDelete)
    {
        <p class="notice">Are you sure you want to delete this learner?</p>
    }
    else
    {
        <p class="notice">This learner has enrollments and cannot be deleted.</p>
    }
    <p><strong>@Model.FirstMidName @Model.LastName</strong> · @Model.Major?.MajorName · @Model.EnrollmentDate.ToString("d")</p>
    @if (canDelete)
    {
        <form asp-action="DeleteConfirmed" method="post" class="actions">
            <input type="hidden" name="id" value="@Model.LearnerId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a class="btn btn-light" asp-action="Index">Cancel</a>
        </form>
    }
</section>
