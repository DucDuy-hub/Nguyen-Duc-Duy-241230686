@model IReadOnlyList<NDD_TH.Models.Student>
@{
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">Lab 1–3 · Validation và Route</p>
        <h1>Danh sách sinh viên</h1>
        <p class="page-subtitle">Dữ liệu minh họa được giữ trong bộ nhớ khi ứng dụng chạy.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Student" asp-action="Create">+ Thêm sinh viên</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<section class="panel-card table-panel">
    <div class="panel-header">
        <div>
            <h2>Student List</h2>
            <p class="muted">@Model.Count sinh viên mẫu</p>
        </div>
        <span class="status-pill">@Model.Count hồ sơ</span>
    </div>
    <div class="table-responsive">
        <table class="table data-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Sinh viên</th>
                    <th>Ngành</th>
                    <th>Giới tính</th>
                    <th>Ngày sinh</th>
                    <th>Hệ</th>
                    <th>Điểm</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model)
                {
                    <tr>
                        <td class="code-cell">@student.Id</td>
                        <td>
                            <div class="person-cell">
                                @if (!string.IsNullOrWhiteSpace(student.AvatarUrl))
                                {
                                    <img class="person-avatar" src="@student.AvatarUrl" alt="Ảnh đại diện của @student.Name" />
                                }
                                else
                                {
                                    <span class="person-avatar avatar-fallback">@student.Name?.FirstOrDefault()</span>
                                }
                                <span>
                                    <strong>@student.Name</strong>
                                    <small>@student.Email</small>
                                </span>
                            </div>
                        </td>
                        <td>@(student.Branch?.ToDisplayName() ?? "—")</td>
                        <td>@(student.Gender?.ToDisplayName() ?? "—")</td>
                        <td>@student.DateOfBirth?.ToString("dd/MM/yyyy")</td>
                        <td>@(student.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                        <td>@student.Score?.ToString("0.0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
