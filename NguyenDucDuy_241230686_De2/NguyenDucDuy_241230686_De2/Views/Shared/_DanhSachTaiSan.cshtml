@model IEnumerable<NguyenDucDuy_241230686_De2.Models.TaiSan>

@foreach (var item in Model)
{
    <div class="asset-card">

        <a href="#">
            <img src="@Url.Content("~/images/" + item.Anh)"
                 alt="@item.TenTs" />
        </a>

        <h2>@item.TenTs</h2>

        <div class="asset-foot">

            <span class="price">
                @item.NguyenGia tr
            </span>

            <a asp-controller="TaiSan"
               asp-action="Edit"
               asp-route-id="@item.MaTs"
               class="btn-buy"
               style="text-decoration:none;">
                Sửa
            </a>

        </div>
    </div>
}
