@using NguyenDucDuy_241230686_De2.Models
@{
    var danhSachLoai = ViewBag.DanhSachLoai as List<LoaiTaiSan>
                        ?? new List<LoaiTaiSan>();
}
<!-- Begin Header -->
<header class="header">
    <div class="topbar">
        <div class="container">
            <span>Phòng Hành chính - Quản trị: <b>(024) 3999 8888</b> &nbsp;|&nbsp; Hỗ trợ: taisan@assethub.vn</span>
            <span>Xin chào, Quản trị viên &nbsp;|&nbsp; Đăng xuất</span>
        </div>
    </div>
    <div class="header-main">
        <div class="container">
            <a href="index.html"><img src="images/logo.png" alt="AssetHub" /></a>
            <div class="cart-box">Tổng tài sản: 16 - Nguyên giá: 3.125 triệu</div>
        </div>
    </div>
    <nav class="navbar">
        <div class="container">
            <ul class="menu">
                <li class="active"><a asp-controller="Home" asp-action="Index">Nguyễn Đức Duy</a></li>
                @foreach (var loai in danhSachLoai)
                {
                    <li><a href="#" class="chon-loai" data-maloai="@loai.MaLoai">@loai.TenLoai</a></li>
                }
            </ul>
            <form class="search-box">
                <input type="text" placeholder="Tìm tài sản..." />
                <button type="button">Tìm</button>
            </form>

            <a asp-controller="TaiSan"
               asp-action="Create"
               style="display:inline-block;
                background:#e5af45;
                color:#173b61;
                padding:10px 15px;
                text-decoration:none;
                font-weight:bold;
                border-radius:5px;">
                + Thêm tài sản
            </a>

        </div>
    </nav>
</header>
<!-- End Header -->