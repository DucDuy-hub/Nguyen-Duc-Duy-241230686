@model NetCoreNDDLAB5.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<h1>Thêm sản phẩm</h1>

<form asp-action="Create"
      method="post"
      enctype="multipart/form-data">

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>

        <input asp-for="Name"
               class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label class="form-label">
            Ảnh sản phẩm
        </label>

        <input type="file"
               name="ImageFile"
               class="form-control" />

        <span class="text-danger">
            @Html.ValidationMessage("ImageFile")
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Price"
               class="form-label">
        </label>

        <input asp-for="Price"
               class="form-control" />

        <span asp-validation-for="Price"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="SalePrice"
               class="form-label">
        </label>

        <input asp-for="SalePrice"
               class="form-control" />

        <span asp-validation-for="SalePrice"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId"
               class="form-label">
        </label>

        <select asp-for="CategoryId"
                asp-items="@ViewBag.Categories"
                class="form-control">

            <option value="">
                -- Chọn danh mục --
            </option>

        </select>

        <span asp-validation-for="CategoryId"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Description"
               class="form-label">
        </label>

        <textarea asp-for="Description"
                  class="form-control"
                  rows="5">
        </textarea>

        <span asp-validation-for="Description"
              class="text-danger">
        </span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Thêm sản phẩm
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Quay lại
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}