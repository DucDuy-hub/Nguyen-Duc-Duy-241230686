
@model IEnumerable<Ndd_lab1.Models.Student>

<h2>Danh sách sinh viên</h2>

<a asp-controller="Student" asp-action="Create"
   class="btn btn-primary">Create Student</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Ngành</th>
            <th>Giới tính</th>
            <th>Hệ đào tạo</th>
            <th>Địa chỉ</th>
            <th>Ảnh đại diện</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Name</td>
                <td>@(s.DateOfBirth == default ? "" : s.DateOfBirth.ToString("dd/MM/yyyy"))</td>
                <td>@(s.Branch switch
                    {
                        Ndd_lab1.Models.Branch.IT => "CNTT",
                        Ndd_lab1.Models.Branch.BE => "Kinh tế",
                        Ndd_lab1.Models.Branch.CE => "Công trình",
                        Ndd_lab1.Models.Branch.EE => "Điện - Điện tử",
                        _ => ""
                    })</td>
                <td>@(s.Gender == Ndd_lab1.Models.Gender.Male ? "Nam" : "Nữ")</td>
                <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                <td>@s.Address</td>
                <td>
                    @if (!string.IsNullOrEmpty(s.Image))
                    {
                        <img src="@s.Image" width="70" height="70"
                             style="object-fit:cover" />
                    }
                </td>
                <td>@s.Email</td>
            </tr>
        }
    </tbody>
</table>
