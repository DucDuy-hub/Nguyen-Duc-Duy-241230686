@model List<MyAppMVC.Models.Product>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<h4>Quản lý sản phẩm</h4>

<table class="table table-bordered table-striped align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
            <th>CreatedAt</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price.ToString("N0") đ</td>
                <td>@item.CreatedAt.ToString("dd-MM-yyyy")</td>
                <td><img src="@item.Image" width="40" /></td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-success btn-sm">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>
