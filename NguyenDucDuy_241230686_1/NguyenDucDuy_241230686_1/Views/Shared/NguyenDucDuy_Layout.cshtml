<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nguyễn Đức Duy - Shop</title>

    <link href="~/css/style.css" rel="stylesheet" type="text/css"  />
</head>
<body>
    <div class="wrap">
        @await Html.PartialAsync("NguyenDucDuy_Header")
        <div class="main">
            <div class="content">
                @RenderBody()
            </div>
        </div>
    </div>
    @await Html.PartialAsync("NguyenDucDuy_Footer")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>