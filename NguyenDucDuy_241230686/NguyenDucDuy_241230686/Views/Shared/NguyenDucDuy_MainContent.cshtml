<!-- Begin Main Content -->

@model IEnumerable<NguyenDucDuy_241230686.Models.Sach>

<main class="main">
    <div class="container">
        
        <div class="banner"><img src="~/images/banner.jpg" alt="Banner" /></div>
<!-- Sách mới -->
        <div class="section-head">
            <h3 id="tieuDeSach">NGUYỄN ĐỨC DUY</h3>
            <a href="#">Xem tất cả &rsaquo;</a>
        </div>

        
        <div class="grid" id="danhSachSach">
            @await Html.PartialAsync("_DanhSachSach", Model)
        </div>

        
    </div>
</main>



<script>
    document.addEventListener("click", async function (event) {
        const link = event.target.closest(".chon-the-loai");

        if (!link) return;

        event.preventDefault();

        const maTL = link.dataset.matl;
        const tieuDe = link.textContent.trim();

        try {
            const response = await fetch(
                "/Home/LocSach?maTL=" + encodeURIComponent(maTL)
            );

            if (!response.ok) {
                throw new Error("Không thể tải danh sách sách");
            }

            const html = await response.text();

            // Cập nhật danh sách sách
            document.getElementById("danhSachSach").innerHTML = html;

            // Cập nhật tiêu đề
            document.getElementById("tieuDeSach").textContent = tieuDe;

            // Xóa màu xanh ở tất cả mục menu
            document.querySelectorAll(".menu li").forEach(function (item) {
                item.classList.remove("active");
            });

            // Thêm màu xanh vào mục vừa chọn
            link.closest("li").classList.add("active");

        } catch (error) {
            console.error(error);
            alert("Có lỗi khi lọc sách. Vui lòng thử lại.");
        }
    });
</script>


<!-- End Main Content -->
