<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <style>
        body { min-height: 100vh; }
        .sidebar { width: 220px; background: #212529; color: #adb5bd; min-height: calc(100vh - 56px); }
        .sidebar a { color: #dee2e6; text-decoration: none; display: block; padding: .5rem 1rem; }
        .sidebar a:hover { background: #343a40; }
        .sidebar .section { font-size: .7rem; text-transform: uppercase; padding: 1rem 1rem .25rem; color: #6c757d; }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark bg-dark px-3">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">Management System</a>
        <span class="text-light small">Logged in as: MyAccount</span>
    </nav>
    <div class="d-flex">
        <aside class="sidebar">
            <div class="section">Core</div>
            <a asp-controller="Home" asp-action="Index">Dashboard</a>
            <div class="section">Addons</div>
            <a asp-controller="Learners" asp-action="Index">Students</a>
        </aside>
        <main class="flex-grow-1">
            @RenderBody()
            <footer class="border-top text-muted small p-3 mt-4">Copyright &copy; 2023</footer>
        </main>
    </div>
</body>
</html>
