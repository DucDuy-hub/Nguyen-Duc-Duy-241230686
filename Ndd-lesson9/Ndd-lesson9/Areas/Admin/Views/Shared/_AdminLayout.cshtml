<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Mộc Admin</title>
    <link rel="stylesheet" href="~/adminlte/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/adminlte/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="hold-transition sidebar-mini layout-fixed admin-shell">
    <div class="wrapper admin-wrapper">
        <nav class="main-header navbar navbar-expand navbar-white navbar-light admin-topbar">
            <ul class="navbar-nav"><li class="nav-item"><a class="nav-link sidebar-toggle" data-widget="pushmenu" href="#" role="button" aria-label="Mở menu"><i class="fas fa-bars"></i></a></li></ul>
            <ul class="navbar-nav ml-auto admin-top-links"><li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Xem cửa hàng <i class="fas fa-external-link-alt"></i></a></li><li class="nav-item"><span class="nav-link admin-user"><span class="admin-avatar">M</span><span>Mộc Admin</span></span></li></ul>
        </nav>
        @await Component.InvokeAsync("NavLeft")
        <div class="content-wrapper admin-main">
            <section class="content-header admin-content-header"><div class="container-fluid admin-heading-inner"><div><p class="admin-overline">MỘC STUDIO / QUẢN TRỊ</p><h1>@ViewData["Title"]</h1></div><div class="admin-breadcrumb"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Trang chủ</a><span>/</span><span>@ViewData["Title"]</span></div></div></section>
            <section class="content admin-content">
                <div class="container-fluid">
                    @if (TempData["Success"] is string success)
                    {
                        <div class="alert alert-success admin-alert" role="status">@success</div>
                    }
                    @if (TempData["Error"] is string error)
                    {
                        <div class="alert alert-danger admin-alert" role="alert">@error</div>
                    }
                    @RenderBody()
                </div>
            </section>
        </div>
        <footer class="main-footer admin-footer"><span>© 2026 Mộc Studio</span><span>Trang quản trị nội dung</span></footer>
    </div>
    <script src="~/adminlte/plugins/jquery/jquery.min.js"></script>
    <script src="~/adminlte/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/adminlte/dist/js/adminlte.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
