@model IEnumerable<Category>
@{
    ViewData["Title"] = "Danh mục";
}
<section class="admin-card table-card">
    <div class="admin-card-heading list-heading"><div><p class="admin-overline">THỰC ĐƠN</p><h2>Danh sách danh mục</h2></div><a class="admin-primary-button" asp-action="Create"><span>＋</span> Thêm danh mục</a></div>
    <form class="table-tools" asp-action="Index" method="get"><label for="search">Tìm danh mục</label><div><input id="search" name="search" value="@ViewData["Search"]" placeholder="Nhập tên danh mục" /><button type="submit">Tìm kiếm</button></div></form>
    <div class="table-responsive"><table class="table admin-table align-middle mb-0"><thead><tr><th>MÃ</th><th>TÊN DANH MỤC</th><th>NGÀY TẠO</th><th>TRẠNG THÁI</th><th class="text-end">THAO TÁC</th></tr></thead><tbody>
    @foreach (var item in Model)
    {
        <tr><td class="text-muted">#@item.Id.ToString("000")</td><td><div class="table-product"><img src="@(item.Image ?? "/images/coffee.svg")" alt="" /><span>@item.Name</span></div></td><td>@item.CreatedDate.ToString("dd/MM/yyyy")</td><td><span class="status-pill @(item.Status == 1 ? "status-on" : "status-off")">@(item.Status == 1 ? "Hiển thị" : "Ẩn")</span></td><td class="text-end"><div class="row-actions"><a asp-action="Details" asp-route-id="@item.Id" aria-label="Xem">↗</a><a asp-action="Edit" asp-route-id="@item.Id" aria-label="Sửa">✎</a><a class="delete-action" asp-action="Delete" asp-route-id="@item.Id" aria-label="Xóa">×</a></div></td></tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="5" class="empty-cell">Chưa có danh mục nào.</td></tr>
    }
    </tbody></table></div>
</section>
