@model Category
@{
    ViewData["Title"] = "Xóa danh mục";
}
<section class="admin-card delete-card"><span class="delete-mark">×</span><p class="admin-overline">XÁC NHẬN XÓA</p><h2>Bạn muốn xóa danh mục này?</h2><p>Danh mục <strong>@Model.Name</strong> sẽ bị xóa khỏi danh sách. Danh mục đang có sản phẩm sẽ được giữ lại.</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><div class="form-actions"><a class="admin-secondary-button" asp-action="Index">Quay lại</a><button class="admin-danger-button" type="submit">Xóa danh mục</button></div></form></section>
