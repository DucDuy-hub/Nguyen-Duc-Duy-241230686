@model Banner
@{
    ViewData["Title"] = "Xóa banner";
}
<section class="admin-card delete-card"><span class="delete-mark">×</span><p class="admin-overline">XÁC NHẬN XÓA</p><h2>Bạn muốn xóa banner này?</h2><p>Banner <strong>@Model.Name</strong> sẽ bị xóa khỏi danh sách.</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><div class="form-actions"><a class="admin-secondary-button" asp-action="Index">Quay lại</a><button class="admin-danger-button" type="submit">Xóa banner</button></div></form></section>
