@model Blog
<input asp-for="Id" type="hidden" /><div class="admin-form-grid"><div class="admin-form-field"><label asp-for="Name"></label><input asp-for="Name" class="form-control" placeholder="Tiêu đề bài viết" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="admin-form-field"><label asp-for="Status"></label><select asp-for="Status" class="form-select"><option value="1">Đã đăng</option><option value="0">Bản nháp</option></select><span asp-validation-for="Status" class="text-danger"></span></div><div class="admin-form-field"><label asp-for="CreatedDate"></label><input asp-for="CreatedDate" type="date" class="form-control" /><span asp-validation-for="CreatedDate" class="text-danger"></span></div><div class="admin-form-field"><label asp-for="Image">Đường dẫn hình ảnh</label><input asp-for="Image" class="form-control" placeholder="/images/coffee.svg" /><span asp-validation-for="Image" class="text-danger"></span></div><div class="admin-form-field field-full"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control" rows="5" placeholder="Tóm tắt nội dung bài viết"></textarea><span asp-validation-for="Description" class="text-danger"></span></div></div>
