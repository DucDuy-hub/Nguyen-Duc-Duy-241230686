@model IEnumerable<Product>
@{
    ViewData["Title"] = "Sản phẩm";
}
<section class="admin-card table-card"><div class="admin-card-heading list-heading"><div><p class="admin-overline">THỰC ĐƠN</p><h2>Danh sách sản phẩm</h2></div><a class="admin-primary-button" asp-action="Create"><span>＋</span> Thêm sản phẩm</a></div><form class="table-tools" asp-action="Index" method="get"><label for="search">Tìm sản phẩm</label><div><input id="search" name="search" value="@ViewData["Search"]" placeholder="Nhập tên sản phẩm" /><button type="submit">Tìm kiếm</button></div></form><div class="table-responsive"><table class="table admin-table align-middle mb-0"><thead><tr><th>MÃ</th><th>SẢN PHẨM</th><th>DANH MỤC</th><th>GIÁ</th><th>GIÁ ƯU ĐÃI</th><th>TRẠNG THÁI</th><th class="text-end">THAO TÁC</th></tr></thead><tbody>@foreach (var item in Model){<tr><td class="text-muted">#@item.Id.ToString("000")</td><td><div class="table-product"><img src="@(item.Image ?? "/images/coffee.svg")" alt="" /><span>@item.Name</span></div></td><td>@item.Category?.Name</td><td>@item.Price.ToString("N0")đ</td><td>@(item.SalePrice > 0 ? item.SalePrice.ToString("N0") + "đ" : "—")</td><td><span class="status-pill @(item.Status == 1 ? "status-on" : "status-off")">@(item.Status == 1 ? "Đang bán" : "Tạm ẩn")</span></td><td class="text-end"><div class="row-actions"><a asp-action="Details" asp-route-id="@item.Id" aria-label="Xem">↗</a><a asp-action="Edit" asp-route-id="@item.Id" aria-label="Sửa">✎</a><a class="delete-action" asp-action="Delete" asp-route-id="@item.Id" aria-label="Xóa">×</a></div></td></tr>}@if (!Model.Any()){<tr><td colspan="7" class="empty-cell">Chưa có sản phẩm nào.</td></tr>}</tbody></table></div></section>
