@model Product
@{
    ViewData["Title"] = "Xóa sản phẩm";
}
<section class="admin-card delete-card"><span class="delete-mark">×</span><p class="admin-overline">XÁC NHẬN XÓA</p><h2>Bạn muốn xóa sản phẩm này?</h2><p>Sản phẩm <strong>@Model.Name</strong> sẽ bị xóa khỏi thực đơn.</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><div class="form-actions"><a class="admin-secondary-button" asp-action="Index">Quay lại</a><button class="admin-danger-button" type="submit">Xóa sản phẩm</button></div></form></section>
