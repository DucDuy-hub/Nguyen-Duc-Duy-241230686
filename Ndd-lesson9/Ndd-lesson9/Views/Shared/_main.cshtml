<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Mộc Studio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Css", required: false)
</head>
<body class="public-site">
    <div class="utility-bar">
        <div class="public-container utility-inner">
            <div class="utility-links"><a href="#about">Về Mộc</a><a href="#contact">Liên hệ</a><a href="/Admin">Đăng nhập</a></div>
            <div class="utility-contact"><span>◷&nbsp; Mỗi ngày 08:00 – 21:00</span><span>⌕&nbsp; 090 123 4567</span></div>
        </div>
    </div>
    <header class="brand-row public-container">
        <a class="brand-mark" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Mộc Studio trang chủ">
            <span class="brand-symbol">M</span><span><strong>MỘC</strong><small>COFFEE & BAKERY</small></span>
        </a>
        <div class="brand-promise">Một khoảng dừng<br /><span>dịu dàng giữa ngày bận rộn</span></div>
        <a class="brand-order" href="#menu">Khám phá thực đơn <span>↗</span></a>
    </header>
    <nav class="public-nav">
        <div class="public-container nav-inner">
            <a class="nav-current" asp-area="" asp-controller="Home" asp-action="Index">TRANG CHỦ</a>
            <a href="#menu">THỰC ĐƠN</a><a href="#story">CÂU CHUYỆN</a><a href="#journal">GÓC MỘC</a><a href="#contact">LIÊN HỆ</a>
        </div>
    </nav>

    <main>@RenderBody()</main>

    <footer class="public-footer" id="contact">
        <div class="public-container footer-grid">
            <div class="footer-brand"><a class="brand-mark" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-symbol">M</span><span><strong>MỘC</strong><small>COFFEE & BAKERY</small></span></a><p>Một góc nhỏ để nhấp chậm, trò chuyện lâu và tìm lại nhịp riêng của mình.</p></div>
            <div><h2>Ghé thăm</h2><p>18 Nguyễn Huệ, Quận 1<br />Thành phố Hồ Chí Minh</p><p>09:00 – 21:00 mỗi ngày</p></div>
            <div><h2>Liên hệ</h2><p>090 123 4567<br />hello@mocstudio.vn</p><p>Instagram&nbsp; · &nbsp;Facebook</p></div>
            <div><h2>Bản tin của Mộc</h2><p>Nhận tin về thức uống theo mùa và những câu chuyện mới.</p><form class="footer-signup"><label class="visually-hidden" for="signup-email">Địa chỉ email</label><input id="signup-email" type="email" placeholder="Email của bạn" /><button type="button" aria-label="Đăng ký">→</button></form></div>
        </div>
        <div class="public-container footer-bottom"><span>© 2026 Mộc Studio</span><span>Chậm một chút, vui nhiều hơn.</span><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Quản trị ↗</a></div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
