@model Ndd_lab1.Models.Student

@{
    ViewData["Title"] = "Thêm sinh viên";
}

<section class="page-heading">
    <div>
        <div class="eyebrow">QUẢN LÝ ĐÀO TẠO</div>
        <h1>Thêm sinh viên</h1>
        <p>Nhập thông tin hồ sơ mới để thêm vào danh sách.</p>
    </div>
</section>

<form class="content-card form-card" asp-controller="Student" asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="validation-summary" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Họ tên</label>
        <input asp-for="Name" class="form-control" placeholder="Nhập họ và tên" />
        <span asp-validation-for="Name" class="field-validation"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" type="email" class="form-control" placeholder="name@gmail.com" />
        <span asp-validation-for="Email" class="field-validation"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">Mật khẩu</label>
        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Password" class="field-validation"></span>
        <small class="form-text">Ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</small>
    </div>

    <div class="mb-3">
        <label asp-for="DateOfBirth" class="form-label">Ngày sinh</label>
        <input asp-for="DateOfBirth" type="date" min="1963-01-01" max="2005-12-31" class="form-control" />
        <span asp-validation-for="DateOfBirth" class="field-validation"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Branch" class="form-label">Ngành học</label>
        <select asp-for="Branch"
                asp-items="Html.GetEnumSelectList<Ndd_lab1.Models.Branch>()"
                class="form-select">
            <option value="">-- Chọn ngành học --</option>
        </select>
        <span asp-validation-for="Branch" class="field-validation"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Giới tính</label><br />
        <label class="form-check form-check-inline">
            <input class="form-check-input" type="radio" asp-for="Gender" value="Male" />
            <span class="form-check-label">Nam</span>
        </label>
        <label class="form-check form-check-inline">
            <input class="form-check-input" type="radio" asp-for="Gender" value="Female" />
            <span class="form-check-label">Nữ</span>
        </label>
        <span asp-validation-for="Gender" class="field-validation"></span>
    </div>

    <div class="mb-3">
        <input asp-for="IsRegular" type="checkbox" />
        <label asp-for="IsRegular">Chính quy</label>
        <span asp-validation-for="IsRegular" class="field-validation"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Score" class="form-label">Điểm</label>
        <input asp-for="Score" type="number" min="0" max="10" step="0.1" class="form-control" placeholder="0.0 - 10.0" />
        <span asp-validation-for="Score" class="field-validation"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Address" class="form-label">Địa chỉ</label>
        <textarea asp-for="Address" class="form-control" rows="3" placeholder="Nhập địa chỉ"></textarea>
        <span asp-validation-for="Address" class="field-validation"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Ảnh đại diện</label>
        <input type="file" name="imageFile" class="form-control" accept="image/*" />
    </div>

    <button type="submit" class="btn btn-primary">Lưu sinh viên</button>
    <a asp-controller="Student" asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
