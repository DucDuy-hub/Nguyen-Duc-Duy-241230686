@model Ndd_lab1.Models.Learner

@{
    ViewData["Title"] = "Thêm người học";
}

<section class="page-heading">
    <div>
        <div class="eyebrow">DATA ACCESS · ENTITY FRAMEWORK</div>
        <h1>Thêm người học</h1>
        <p>Nhập thông tin người học và chọn chuyên ngành.</p>
    </div>
</section>

<form asp-action="Create" method="post" class="content-card form-card learner-form">
    <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
    <div class="mb-3">
        <label asp-for="FirstMidName" class="form-label"></label>
        <input asp-for="FirstMidName" class="form-control" placeholder="Nhập tên" />
        <span asp-validation-for="FirstMidName" class="field-validation"></span>
    </div>
    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" placeholder="Nhập họ" />
        <span asp-validation-for="LastName" class="field-validation"></span>
    </div>
    <div class="mb-3">
        <label asp-for="MajorID" class="form-label"></label>
        <select asp-for="MajorID" asp-items="ViewBag.MajorID" class="form-select">
            <option value="">-- Chọn chuyên ngành --</option>
        </select>
        <span asp-validation-for="MajorID" class="field-validation"></span>
    </div>
    <div class="mb-3">
        <label asp-for="EnrollmentDate" class="form-label"></label>
        <input asp-for="EnrollmentDate" type="date" class="form-control" />
        <span asp-validation-for="EnrollmentDate" class="field-validation"></span>
    </div>
    <div class="form-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        <button type="submit" class="btn btn-primary">Lưu người học</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
