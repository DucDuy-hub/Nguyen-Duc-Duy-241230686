@model IEnumerable<NguyenDucDuy_241230686_2.Models.TaiSan>
<!-- Begin Main Content -->
<main class="main">
    <div class="container">
        
        <!-- Tài sản mới nhập -->
        <div class="section-head">
            <h3>Nguyễn Đức Duy</h3>
            <a href="#">Xem tất cả &rsaquo;</a>
        </div>
        <div class="grid">
            @foreach (var item in Model)
            {

                <div class="asset-card">
                    <a href="#"><img src="@Url.Content("~/images/" + item.Anh)" alt="@item.TenTs" /></a>
                    <h2>@item.TenTs</h2>
                    <div class="asset-foot"><span class="price">@item.NguyenGia tr</span><button class="btn-buy">Chi tiết</button></div>
                </div>
            }

        </div>

    </div>
</main>
<!-- End Main Content -->